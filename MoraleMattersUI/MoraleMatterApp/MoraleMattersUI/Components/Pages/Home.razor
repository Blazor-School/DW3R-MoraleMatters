@page "/"
@inject ThemeService ThemeService
@inject ModService ModService
@inject IFolderPicker NativeFolderPicker
@inject IServiceProvider ServiceProvider
@implements IDisposable

<main class="wa-stack content-padding settings-page">
    <EditForm EditContext="GameFolderEditContext" style="flex-shrink: 0;">
        <RoarCard Appreance="CardAppreance.FilledOutlined">
            <DataAnnotationsValidator />
            <div class="wa-cluster wa-flex-nowrap">
                <RoarIcon Size="@IconSize.XL" Color="@ThemeService.CustomTheme.Token.Variants[RoarVariant.Brand].Color" Name="folder" />
                <label>Game folder</label>
                <RoarInputText style="flex-grow: 1" @bind-Value="GameFolderForm.GamePath" ReadOnly />
                <RoarButton @onclick="BrowseGameFolderAsync" Variant="ButtonVariant.Brand">Browse</RoarButton>
            </div>
            <ValidationMessage For="() => GameFolderForm.GamePath" />
        </RoarCard>
    </EditForm>
    <div class="wa-flank:end wa-align-items-stretch wa-flex-nowrap" style="--flank-size: 30rem; flex: 1; min-height: 0;">
        <RoarCard class="settings-card" Appreance="CardAppreance.FilledOutlined">
            <div class="wa-flank" style="flex-shrink: 0;">
                <RoarIcon Size="@IconSize.L" Color="@ThemeService.CustomTheme.Token.Variants[RoarVariant.Brand].Color" Name="gear" />
                <div class="wa-heading-xl">Mod Settings</div>
            </div>

            @if (string.IsNullOrEmpty(LocalModVersion))
            {
                <div class="wa-stack wa-text-center wa-align-items-center wa-justify-content-center wa-gap-l" style="flex: 1; min-height: 0; overflow-y: auto;">
                    <RoarIcon Name="sliders" class="wa-border-radius-l" style="font-size: 3rem;" Color="@ThemeService.CustomTheme.Token.Variants[RoarVariant.Brand].Color" />

                    <div class="wa-heading-l">Install MoraleMatters to get started</div>

                    <div class="wa-body">
                        <span>Choose a version in the panel on the right.</span>
                        <p>Your mod settings will appear here after installation.</p>
                    </div>

                    <div class="wa-cluster wa-justify-content-center">
                        <RoarIcon Size="@IconSize.L" Name="lock" />
                        <span>Settings unavailable until the mod is installed.</span>
                    </div>
                </div>
            }
            else
            {
                <EditForm EditContext="SettingEditContext" class="wa-stack" style="flex: 1; min-height: 0;">
                    <div class="wa-stack" style="flex: 1; min-height: 0; overflow-y: auto; scrollbar-gutter: stable;">
                        <RoarDetails Appearance="DetailsAppearance.FilledOutlined">
                            <div slot="@DetailsSlot.Summary">
                                <div class="wa-heading-l">
                                    <RoarIcon Name="hand-fist" />
                                    Combat settings
                                </div>
                                <div class="wa-body-s">The higher the morale, the more effective the unit's combat abilities. Affect both allies and enemies.</div>
                            </div>
                            <div class="wa-stack">
                                <div class="wa-stack wa-gap-xs">
                                    <RoarSwitch @bind-Value="SettingForm.CombatEnabled" Hint="Scale ordinary combat damage and native AI attack waits according to corps morale.">Combat scaling</RoarSwitch>
                                    <ValidationMessage For="() => SettingForm.CombatEnabled" />
                                </div>
                                <div class="wa-body-s">Each row sets the combat effects at its configured morale point. Effects change gradually between points. Below the first point or above the last point, the nearest row's effects apply.</div>
                                <div class="wa-body-s">Example with default settings: At 300 morale, effects are halfway between the 200 and 400 morale rows. Damage dealt is halfway between 0.55 and 1.00, giving a multiplier of 0.775.</div>
                                <div style="overflow-x: auto;">
                                    <table class="table-input">
                                        <caption class="wa-visually-hidden">Combat scaling by morale tier</caption>
                                        <thead>
                                            <tr>
                                                <th id="combat-tier-header" scope="col" tabindex="0">Morale tier</th>
                                                <th id="combat-points-header" scope="col" tabindex="0">Morale points</th>
                                                <th id="combat-damage-dealt-header" scope="col" tabindex="0">Damage dealt</th>
                                                <th id="combat-damage-taken-header" scope="col" tabindex="0">Damage taken</th>
                                                <th id="combat-attack-frequency-header" scope="col" tabindex="0">Attack frequency</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <th scope="row">
                                                    <div class="wa-body">Very low</div>
                                                    <div class="wa-body">At @SettingForm.CombatVeryLowMorale morale</div>
                                                </th>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryLowMorale" Label="Very Low Morale" min="1" max="@(SettingForm.CombatLowMorale - 1)" step="1" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryLowMorale" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryLowDamageDealt" Label="Very Low Damage Dealt" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryLowDamageDealt" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryLowDamageTaken" Label="Very Low Damage Taken" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryLowDamageTaken" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryLowAttackFrequency" Label="Very Low Attack Frequency" min="0.1" max="5" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryLowAttackFrequency" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <th scope="row">
                                                    <div class="wa-body">Low</div>
                                                    <div class="wa-body">At @SettingForm.CombatLowMorale morale</div>
                                                </th>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatLowMorale" Label="Low Morale" min="@(SettingForm.CombatVeryLowMorale + 1)" max="@(SettingForm.CombatReferenceMorale - 1)" step="1" />
                                                    <ValidationMessage For="() => SettingForm.CombatLowMorale" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatLowDamageDealt" Label="Low Damage Dealt" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatLowDamageDealt" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatLowDamageTaken" Label="Low Damage Taken" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatLowDamageTaken" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatLowAttackFrequency" Label="Low Attack Frequency" min="0.1" max="5" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatLowAttackFrequency" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <th scope="row">
                                                    <div class="wa-body">Normal</div>
                                                    <div class="wa-body">At @SettingForm.CombatReferenceMorale morale</div>
                                                </th>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatReferenceMorale" Label="Reference Morale" min="@(SettingForm.CombatLowMorale + 1)" max="@(SettingForm.CombatHighMorale - 1)" step="1" />
                                                    <ValidationMessage For="() => SettingForm.CombatReferenceMorale" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatReferenceDamageDealt" Label="Reference Damage Dealt" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatReferenceDamageDealt" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatReferenceDamageTaken" Label="Reference Damage Taken" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatReferenceDamageTaken" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatReferenceAttackFrequency" Label="Reference Attack Frequency" min="0.1" max="5" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatReferenceAttackFrequency" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <th scope="row">
                                                    <div class="wa-body">High</div>
                                                    <div class="wa-body">At @SettingForm.CombatHighMorale morale</div>
                                                </th>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatHighMorale" Label="High Morale" min="@(SettingForm.CombatReferenceMorale + 1)" max="@(SettingForm.CombatVeryHighMorale - 1)" step="1" />
                                                    <ValidationMessage For="() => SettingForm.CombatHighMorale" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatHighDamageDealt" Label="High Damage Dealt" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatHighDamageDealt" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatHighDamageTaken" Label="High Damage Taken" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatHighDamageTaken" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatHighAttackFrequency" Label="High Attack Frequency" min="0.1" max="5" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatHighAttackFrequency" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <th scope="row">
                                                    <div class="wa-body">Very high</div>
                                                    <div class="wa-body">At @SettingForm.CombatVeryHighMorale morale</div>
                                                </th>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryHighMorale" Label="Very High Morale" min="@(SettingForm.CombatHighMorale + 1)" max="899" step="1" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryHighMorale" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryHighDamageDealt" Label="Very High Damage Dealt" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryHighDamageDealt" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryHighDamageTaken" Label="Very High Damage Taken" min="0.05" max="10" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryHighDamageTaken" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.CombatVeryHighAttackFrequency" Label="Very High Attack Frequency" min="0.1" max="5" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.CombatVeryHighAttackFrequency" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <RoarTooltip For="combat-tier-header">The five combat scaling tiers, from very low to very high morale.</RoarTooltip>
                                    <RoarTooltip For="combat-points-header">Native morale points for each scaling anchor. Effects interpolate between anchors.</RoarTooltip>
                                    <RoarTooltip For="combat-damage-dealt-header">Outgoing damage multiplier. 1 means normal damage; 2 doubles the coefficient.</RoarTooltip>
                                    <RoarTooltip For="combat-damage-taken-header">Incoming damage multiplier. 1 means normal damage; 0.5 halves the coefficient.</RoarTooltip>
                                    <RoarTooltip For="combat-attack-frequency-header">The attack rate, not the animation speed. Value from 1 to 5.</RoarTooltip>
                                </div>
                                <div class="wa-stack wa-gap-xs">
                                    <RoarSlider @bind-Value="SettingForm.CombatNamedOfficerStrength" Hint="Strength of combat scaling and native AI profile shifts for named officers" Min="0" Max="1" Label="Named officer effect strength" Step="0.01" WithTooltip>
                                        <span slot="@SliderSlot.Reference">Neutral</span>
                                        <span slot="@SliderSlot.Reference">Full effect</span>
                                    </RoarSlider>
                                    <ValidationMessage For="() => SettingForm.CombatNamedOfficerStrength" />
                                </div>
                                <div class="wa-stack">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.CasualtiesEnabled" Hint="Corps will lose morale when units are defeated.">Casualty morale penalties</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.CasualtiesEnabled" />
                                    </div>
                                </div>
                                <div class="wa-grid wa-align-items-start" style="--min-column-size: 16rem;">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.CasualtiesSoldier" Hint="Corps morale points lost per ordinary soldier killed." Label="Soldier" min="0" max="898" step="1" />
                                        <ValidationMessage For="() => SettingForm.CasualtiesSoldier" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.CasualtiesElite" Hint="Corps morale points lost per elite soldier killed." Label="Elite" min="0" max="898" step="1" />
                                        <ValidationMessage For="() => SettingForm.CasualtiesElite" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.CasualtiesCaptain" Hint="Corps morale points lost when a generic group captain is defeated." Label="Captain" min="0" max="898" step="1" />
                                        <ValidationMessage For="() => SettingForm.CasualtiesCaptain" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.CasualtiesSubordinateOfficer" Hint="Corps morale points lost when a subordinate named officer is defeated; corps commander defeat keeps its native outcome." Label="Subordinate Officer" min="0" max="898" step="1" />
                                        <ValidationMessage For="() => SettingForm.CasualtiesSubordinateOfficer" />
                                    </div>
                                </div>
                            </div>
                        </RoarDetails>
                        <RoarDetails Appearance="DetailsAppearance.FilledOutlined">
                            <div slot="@DetailsSlot.Summary">
                                <div class="wa-heading-l">
                                    <RoarIcon Name="brain" />
                                    Behavior settings
                                </div>
                                <div class="wa-body-s">Morale shapes how units fight, hold formation, regroup and recover.</div>
                            </div>
                            <div class="wa-stack">
                                <div class="wa-stack wa-gap-xs">
                                    <RoarSwitch @bind-Value="SettingForm.BehaviorEnabled" Hint="Enable the behavior features below, including phased regrouping.">Morale-driven behavior</RoarSwitch>
                                    <ValidationMessage For="() => SettingForm.BehaviorEnabled" />
                                </div>
                                <div class="wa-grid wa-align-items-start" style="--min-column-size: 14rem;">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.BehaviorAIProfiles" Hint="Affect aggression, guarding and supported evasion.">AI decision profiles</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.BehaviorAIProfiles" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.BehaviorFormationCohesion" Hint="Adjust infantry spacing while keeping strategic orders.">Formation cohesion</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.BehaviorFormationCohesion" />
                                    </div>
                                </div>
                                <div class="wa-body-s">Effects change gradually between very low morale and very high morale.</div>
                                <div style="overflow-x: auto;">
                                    <table class="table-input" style="min-width: 32rem;">
                                        <caption class="wa-visually-hidden">Behavior effects by morale tier</caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Morale tier</th>
                                                <th id="behavior-profile-header" scope="col" tabindex="0">AI profile shift</th>
                                                <th id="behavior-spacing-header" scope="col" tabindex="0">Formation spacing</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <th scope="row">
                                                    <div class="wa-body">Very low</div>
                                                </th>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.BehaviorLowMoraleProfileShift" Label="Very low morale AI profile shift" min="-19" max="0" step="1" />
                                                    <ValidationMessage For="() => SettingForm.BehaviorLowMoraleProfileShift" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.BehaviorLowMoraleFormationScale" Label="Very low morale formation spacing" min="1" max="2" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.BehaviorLowMoraleFormationScale" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <th scope="row">
                                                    <div class="wa-body">Very high</div>
                                                </th>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.BehaviorHighMoraleProfileShift" Label="Very high morale AI profile shift" min="0" max="19" step="1" />
                                                    <ValidationMessage For="() => SettingForm.BehaviorHighMoraleProfileShift" />
                                                </td>
                                                <td>
                                                    <RoarInputNumber class="wa-visually-hidden-label" Size="InputSize.S" @bind-Value="SettingForm.BehaviorHighMoraleFormationScale" Label="Very high morale formation spacing" min="0.5" max="1" step="0.05" />
                                                    <ValidationMessage For="() => SettingForm.BehaviorHighMoraleFormationScale" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <RoarTooltip For="behavior-profile-header">Lower profile means less blocking chance, pause longer between actions. Shift in the native AI decision profile. Negative values reduce the profile; positive values increase it. The final shift is rounded and limited to the unit's native profile family.</RoarTooltip>
                                    <RoarTooltip For="behavior-spacing-header">Formation spacing multiplier. 1 is normal spacing; values above 1 spread infantry out, and values below 1 bring them closer.</RoarTooltip>
                                </div>
                                <div class="wa-body-s">A spacing multiplier of 1.00 is normal. Named officer profile shifts use the effect strength in Combat settings.</div>
                                <RoarDivider />
                                <div class="wa-stack">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.BehaviorLocalRegroup" Disabled="@(!SettingForm.BehaviorEnabled)" Hint="Ordinary infantry regroup at low morale or after defeat shock. Named officers keep their strategic orders.">Infantry regrouping</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.BehaviorLocalRegroup" />
                                    </div>
                                    <div class="wa-grid wa-align-items-start" style="--min-column-size: 10rem;">
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorRegroupBelowPercent" OnInput="ValidateBehaviorRegroup" Label="Start at or below" min="0" max="50" step="1">
                                                <span slot="@InputSlot.End">%</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BehaviorRegroupBelowPercent" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorRegroupRecoverPercent" OnInput="ValidateBehaviorRegroup" Label="End early at" min="0" max="80" step="1">
                                                <span slot="@InputSlot.End">%</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BehaviorRegroupRecoverPercent" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorRegroupSeconds" Hint="Includes fall-back, reform and rejoin phases when enabled." Label="Regroup duration" min="1" max="30" step="1">
                                                <span slot="@InputSlot.End">s</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BehaviorRegroupSeconds" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorRegroupCooldownSeconds" Label="Cooldown after regroup" min="5" max="120" step="1">
                                                <span slot="@InputSlot.End">s</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BehaviorRegroupCooldownSeconds" />
                                        </div>
                                    </div>
                                    <RoarDivider />
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.BattlefieldPhasedRegroup" Hint="Split local infantry regrouping into fall-back, reform and rejoin phases.">Fall back, reform and rejoin</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.BattlefieldPhasedRegroup" />
                                    </div>
                                    <div class="wa-grid wa-align-items-start" style="--min-column-size: 12rem;">
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BattlefieldReformFormationScale" Hint="Spacing multiplier during the reform phase; 0.45 is 45% of normal spacing." Label="Reform formation spacing" min="0.25" max="1" step="0.05" />
                                            <ValidationMessage For="() => SettingForm.BattlefieldReformFormationScale" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BattlefieldWithdrawalDistanceMetres" Hint="Maximum shift toward a nearby living commander during phased regrouping." Label="Withdrawal distance" min="0" max="15" step="1">
                                                <span slot="@InputSlot.End">m</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BattlefieldWithdrawalDistanceMetres" />
                                        </div>
                                    </div>
                                </div>
                                <RoarDivider />
                                <div class="wa-stack">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.BehaviorDefeatPanic" Hint="A defeated subordinate leader can cause extra corps morale loss and temporary shock nearby.">Panic after nearby defeats</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.BehaviorDefeatPanic" />
                                    </div>
                                    <div class="wa-grid wa-align-items-start" style="--min-column-size: 12rem;">
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorPanicRadiusMetres" Label="Panic radius" min="1" max="100" step="1">
                                                <span slot="@InputSlot.End">m</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BehaviorPanicRadiusMetres" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorPanicMoraleLoss" Label="Base morale loss (points)" min="0" max="100" step="1" />
                                            <ValidationMessage For="() => SettingForm.BehaviorPanicMoraleLoss" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorPanicShockSeconds" Label="Base shock duration" min="0" max="30" step="1">
                                                <span slot="@InputSlot.End">s</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BehaviorPanicShockSeconds" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorPanicWindowSeconds" Label="Loss budget window" min="1" max="60" step="1">
                                                <span slot="@InputSlot.End">s</span>
                                            </RoarInputNumber>
                                            <ValidationMessage For="() => SettingForm.BehaviorPanicWindowSeconds" />
                                        </div>
                                        <div class="wa-stack wa-gap-xs">
                                            <RoarInputNumber Size="InputSize.S" @bind-Value="SettingForm.BehaviorPanicWindowCap" Label="Loss cap per window (points)" min="0" max="200" step="1" />
                                            <ValidationMessage For="() => SettingForm.BehaviorPanicWindowCap" />
                                        </div>
                                    </div>
                                    <div class="wa-body-s">The cap limits extra panic losses per corps. Morale and commander protection can reduce the effect.</div>
                                </div>
                                <RoarDivider />
                                <div class="wa-stack">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.BehaviorMoraleRecovery" Hint="Recover base morale while the entire corps is out of simulated combat.">Passive morale recovery</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.BehaviorMoraleRecovery" />
                                    </div>
