                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldTrendSeconds" Hint="Battle-second history window used to calculate morale trends and recent distress losses." Label="Trend seconds" min="3" max="30" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldTrendSeconds" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldReasonSeconds" Hint="Battle seconds a recorded morale-change reason remains visible in the panel." Label="Reason seconds" min="2" max="15" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldReasonSeconds" />
                                    </div>
                                </div>
                                <RoarDivider />
                                <h3 class="wa-heading">Distress alerts</h3>
                                <RoarSwitch @bind-Value="SettingForm.BattlefieldDistressSignals" Hint="Show distress alerts for wounded allied officers in corps with low, deteriorating morale.">Distress notifications</RoarSwitch>
                                <ValidationMessage For="() => SettingForm.BattlefieldDistressSignals" />
                                <div class="wa-grid wa-align-items-start" style="--min-column-size: 16rem;">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldDistressMoralePercent" Hint="Maximum corps morale percentage for an allied officer to qualify for distress detection." Label="Distress morale percent" min="5" max="60" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldDistressMoralePercent" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldDistressHealthPercent" Hint="Maximum named-officer health percentage for distress detection; low morale and recent losses are also required." Label="Distress health percent" min="5" max="80" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldDistressHealthPercent" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldDistressDropPercent" Hint="Minimum drop in morale percentage points during the trend window that can qualify a distressed corps." Label="Distress drop percent" min="0.5" max="20" step="0.1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldDistressDropPercent" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldDistressCasualties" Hint="Minimum confirmed casualties during the trend window that can qualify a distressed corps instead of a morale drop." Label="Distress casualties" min="1" max="30" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldDistressCasualties" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldAlertSeconds" Hint="Battle seconds that distress and rescue-completion notifications remain visible." Label="Alert seconds" min="2" max="15" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldAlertSeconds" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldAlertCooldownSeconds" Hint="Minimum battle seconds between distress alerts across all corps." Label="Alert cooldown seconds" min="10" max="180" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldAlertCooldownSeconds" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputNumber @bind-Value="SettingForm.BattlefieldCorpsAlertCooldownSeconds" Hint="Minimum battle seconds between alerts for the same corps; also delays a rescue retry after failure." Label="Corps alert cooldown seconds" min="30" max="300" step="1" />
                                        <ValidationMessage For="() => SettingForm.BattlefieldCorpsAlertCooldownSeconds" />
                                    </div>
                                </div>
                                <RoarDivider />
                                <h3 class="wa-heading">Battle reports</h3>
                                <RoarSwitch @bind-Value="SettingForm.ReportEnabled" Hint="Enable the in-game contribution report overlay.">Battle report overlay</RoarSwitch>
                                <ValidationMessage For="() => SettingForm.ReportEnabled" />
                                <div class="wa-grid wa-align-items-start" style="--min-column-size: 16rem;">
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarInputText @bind-Value="SettingForm.ReportKey" Hint="UE4SS key name used to toggle the contribution report, for example F8." Label="Report toggle key" />
                                        <ValidationMessage For="() => SettingForm.ReportKey" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.ReportShowOnResults" Hint="Automatically open the contribution report on the results screen when the report overlay is enabled.">Show on results</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.ReportShowOnResults" />
                                    </div>
                                    <div class="wa-stack wa-gap-xs">
                                        <RoarSwitch @bind-Value="SettingForm.ReportSaveToFile" Hint="Write the final battle report to MoraleMatters-last-battle.txt beside the ASI.">Save to file</RoarSwitch>
                                        <ValidationMessage For="() => SettingForm.ReportSaveToFile" />
                                    </div>
                                </div>
                                <RoarDivider />
                                <h3 class="wa-heading">Diagnostics</h3>
                                <RoarSwitch @bind-Value="SettingForm.GeneralProfile" Hint="Write update timing diagnostics to UE4SS.log to help investigate performance.">Performance diagnostics</RoarSwitch>
                                <ValidationMessage For="() => SettingForm.GeneralProfile" />
                            </div>
                        </RoarDetails>
                    </div>
                    <RoarDivider />
                    <div class="wa-cluster wa-justify-content-space-between">
                        <div>
                            @if (SettingEditContext.IsModified())
                            {
                                <RoarBadge Variant="BadgeVariant.Warning">Unsaved changes</RoarBadge>
                            }
                            else
                            {
                                <RoarBadge Variant="BadgeVariant.Neutral">No changes</RoarBadge>
                            }
                        </div>
                        <div>
                            <RoarButton @onclick="ResetSettingForm">Restore defaults</RoarButton>
                            <RoarButton Variant="ButtonVariant.Brand" @onclick="SaveSettingAsync">Save settings</RoarButton>
                        </div>
                    </div>
                </EditForm>
            }
        </RoarCard>
        <div class="wa-stack" style="min-height: 0; overflow-y: auto;">
            <RoarCard Orientation="CardOrientation.Vertical" Appreance="CardAppreance.FilledOutlined">
                <div class="wa-flank">
                    <RoarIcon Size="@IconSize.L" Color="@ThemeService.CustomTheme.Token.Variants[RoarVariant.Brand].Color" Name="download" />
                    <div class="wa-split">
                        <div class="wa-heading-xl">Mod Installation</div>

                        @if (string.IsNullOrEmpty(LocalModVersion))
                        {
                            <RoarBadge Variant="BadgeVariant.Neutral">Not installed</RoarBadge>
                        }

                        @if (!string.IsNullOrEmpty(LocalModVersion))
                        {
                            <RoarBadge Variant="BadgeVariant.Brand">Installed: @LocalModVersion</RoarBadge>
                        }

                    </div>
                </div>
                <div class="wa-body">Select mod version</div>
                <RoarSelect @bind-Value="SelectedModAssetVersion" Placeholder="Select mod version">
                    @foreach (var asset in ModAssets)
                    {
                        <RoarOption Value="@asset.Version.ToString()">@asset.Version</RoarOption>
                    }
                </RoarSelect>

                @if (SelectedModAsset is not null)
                {
                    <div class="wa-body">Changelog</div>
                    <RoarCard Appreance="CardAppreance.FilledOutlined">
                        @SelectedModAsset.NotesMarkdown
                    </RoarCard>
                }

                <RoarDivider />

                @if (LocalModVersion == SelectedModAssetVersion)
                {
                    <RoarButton class="full-width" Disabled Variant="ButtonVariant.Neutral">Installed</RoarButton>
                }
                else
                {
                    <RoarButton class="full-width" Variant="ButtonVariant.Brand" @onclick="DownloadAndInstallMod" Loading="@InstallLoading">Install</RoarButton>
                }
            </RoarCard>

            <RoarCard Orientation="CardOrientation.Vertical" Appreance="CardAppreance.FilledOutlined">
                <div class="wa-stack">
                    <div class="wa-flank">
                        <RoarIcon Size="@IconSize.XL" Color="@ThemeService.CustomTheme.Token.Variants[RoarVariant.Warning].Color" Name="circle-info" />
                        <div class="wa-body-m">Keep the game closed during installion.</div>
                    </div>
                    <div class="wa-flank">
                        <img src="morale_matters_icon.png" alt="MoraleMatters" width="32" height="32" />
                        <div class="wa-body-m">UI version: @(AppInfo.Current.Version.Major).@(AppInfo.Current.BuildString)</div>
                    </div>
                </div>
            </RoarCard>
        </div>
    </div>
</main>

<RoarToast @ref="Toast" />

@code {
    public GameFolderForm GameFolderForm { get; set; } = new();
    public EditContext GameFolderEditContext { get; set; } = default!;
    public string LocalModVersion { get; set; } = "";
    public IDisposable? GameFolderFormValidator { get; set; }
    public List<VelopackAsset> ModAssets { get; set; } = [];
    public string? SelectedModAssetVersion { get; set; }
    public VelopackAsset? SelectedModAsset => ModAssets.FirstOrDefault(x => x.Version.ToString() == SelectedModAssetVersion);
    public bool InstallLoading { get; set; } = false;
    public ModSettingForm SettingForm { get; set; } = new();
    public EditContext SettingEditContext { get; set; } = default!;
    public IDisposable? SettingFormValidator { get; set; }
    public RoarToast Toast { get; set; } = default!;

    private void ValidateBehaviorRegroup() => SettingEditContext.Validate();

    protected override async Task OnInitializedAsync()
    {
        GameFolderForm.GamePath = Preferences.Default.Get(nameof(GameFolderForm.GamePath), "");
        GameFolderEditContext = new(GameFolderForm);
        GameFolderFormValidator = GameFolderEditContext.EnableDataAnnotationsValidation(ServiceProvider);
        SettingEditContext = new(SettingForm);
        SettingFormValidator = SettingEditContext.EnableDataAnnotationsValidation(ServiceProvider);
        await UpdateModInstallationAsync();
    }

    public async Task BrowseGameFolderAsync()
    {
        var result = await MainThread.InvokeOnMainThreadAsync(() => NativeFolderPicker.PickAsync());

        if (result.IsSuccessful)
        {
            GameFolderForm.GamePath = result.Folder.Path;
            Preferences.Default.Set(nameof(GameFolderForm.GamePath), GameFolderForm.GamePath);
            await UpdateModInstallationAsync();
        }
    }

    private async Task UpdateModInstallationAsync()
    {
        if (Application.Current is App app)
        {
            if (!GameFolderEditContext.Validate())
            {
                app.TitleBar.Subtitle = "Game not found.";
            }
            else
            {
                LocalModVersion = await ModService.GetLocalModVersionAsync(GameFolderForm.GamePath);
                ModAssets = await ModService.GetModReleasesAsync();

                if (ModAssets.Count > 0 && string.IsNullOrEmpty(SelectedModAssetVersion))
                {
                    SelectedModAssetVersion = ModAssets.First().Version.ToString();
                }

                if (string.IsNullOrEmpty(LocalModVersion))
                {
                    app.TitleBar.Subtitle = "Mod not installed";
                    ResetSettingForm();
                }
                else
                {
                    app.TitleBar.Subtitle = $"Mod version: {LocalModVersion}";
                    SettingForm.LoadModSettings(GameFolderForm.GamePath);
                }
            }
        }
    }

    public async Task DownloadAndInstallMod()
    {
        InstallLoading = true;
        await ModService.InstallModAsync(GameFolderForm.GamePath, SelectedModAsset);
        await UpdateModInstallationAsync();
        InstallLoading = false;
    }

    public void ResetSettingForm()
    {
        SettingFormValidator?.Dispose();
        SettingForm = new();
        SettingEditContext = new(SettingForm);
        SettingFormValidator = SettingEditContext.EnableDataAnnotationsValidation(ServiceProvider);
    }

    public void Dispose()
    {
        GameFolderFormValidator?.Dispose();
        SettingFormValidator?.Dispose();
    }

    public async Task SaveSettingAsync()
    {
        if (SettingEditContext.Validate())
        {
            await ModService.SaveModSettingsAsync(GameFolderForm.GamePath, SettingForm);
            await Toast.CreateAsync("Save successfully. Take effect after restarting the game.", new()
            {
                Variant = ToastVariant.Success,
            });
            SettingEditContext.MarkAsUnmodified();
        }
        else
        {
            await Toast.CreateAsync("Settings contain invalid values", new()
            {
                Variant = ToastVariant.Danger,
            });
        }
    }
}
